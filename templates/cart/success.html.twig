{% extends 'base.html.twig' %}

{% block title %}Paiement Réussi - Flore Brésilienne{% endblock %}

{% block body %}
<div class="container py-5 text-center">
    <div class="card border-0 shadow-sm rounded-4 p-5 mx-auto" style="max-width: 600px;">
        <div class="mb-4">
            <i class="fas fa-check-circle text-success display-1"></i>
        </div>
        <h1 class="fw-bold mb-3">Merci pour votre commande !</h1>
        <p class="text-muted mb-4">Votre paiement a été validé avec succès via Stripe. Nous préparons votre commande pour l'expédition ou le retrait au salon.</p>
        <a href="{{ path('app_shop') }}" class="btn btn-primary rounded-pill py-3 px-5 fw-bold shadow-sm">
            Retourner à la boutique
        </a>
    </div>
</div>
{% endblock %}