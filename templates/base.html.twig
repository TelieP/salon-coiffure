<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>{% block title %}bresilienne F - Salon de Coiffure{% endblock %}</title>
        <!-- Bootstrap 5 CSS -->
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
        <!-- FontAwesome -->
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
        <!-- Leaflet CSS (Pour la carte) -->
        <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
        <!-- Google Fonts (Plus Jakarta Sans) -->
        <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
        <link href="https://cdn.jsdelivr.net/npm/remixicon@3.5.0/fonts/remixicon.css" rel="stylesheet">
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
        <style>
            :root {
                --salonkee-coral: #f18763;
                --salonkee-coral-hover: #e07450;
                --salonkee-bg: #f9fafb;
                --text-dark: #2d3748;
            }
            body { 
                font-family: 'Plus Jakarta Sans', sans-serif; 
                background-color: var(--salonkee-bg); 
                color: var(--text-dark);
            }
            .btn-coral {
                background-color: var(--salonkee-coral);
                color: white;
                font-weight: 600;
                border: none;
                border-radius: 8px;
            }
            .btn-coral:hover {
                background-color: var(--salonkee-coral-hover);
                color: white;
            }
            .text-coral { color: var(--salonkee-coral); }
            .badge-verified {
                background-color: #e6f4ea;
                color: #137333;
                font-size: 0.8rem;
                font-weight: 600;
            }
            .star-rating { color: #f5a623; }
/* Navbar fixe avec effet blur élégant et hauteur réduite */
.navbar.fixed-top {
    background-color: rgba(255, 255, 255, 0.85) !important;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
    transition: all 0.3s ease-in-out;
    padding-top: 0.2rem !important;
    padding-bottom: 0.2rem !important;
}

/* Agrandissement du logo pour plus de visibilité */
.navbar-brand img {
    height: 95px !important;
    width: auto;
    max-height: none;
}

/* Ajustement du décalage du corps par rapport à la nouvelle hauteur de la navbar */
body {
    padding-top: 80px;
}    </style>
        {% block stylesheets %}{% endblock %}
    </head>
    <body>
      
<nav id="mainNavbar" class="navbar navbar-expand-lg navbar-light fixed-top transition-all py-3">
    <div class="container">
        <a class="navbar-brand" href="{{ path('app_home') }}">
            <img src="{{ asset('images/logo.png') }}" alt="Flore Brésilienne" style="height: 220px; width: auto;">
        </a>

        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse justify-content-between" id="navbarNav">
            <!-- Vos liens de navigation -->
            <ul class="navbar-nav mx-auto mb-2 mb-lg-0 gap-3">
                <li class="nav-item">
                    <a class="nav-link fw-semibold" href="{{ path('app_home') }}#accueil">
                       
                        <i class="fas fa-home fa-lg"></i>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link fw-semibold" href="{{ path('app_home') }}#produits">Produits</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link fw-semibold" href="{{ path('app_home') }}#prestations">Prestations</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link fw-semibold" href="{{ path('app_home') }}#contact">Contact</a>
                </li>
            </ul>

            <!-- Boutons de compte -->
            <div class="d-flex align-items-center gap-2">
                {% if app.user %}
                    <span class="fw-semibold text-dark me-2">Bonjour {{ app.user.lastname }}
                        <i class="fas fa-smile fa-lg text-warning"></i>
                    </span>
                    <a href="{{ path('app_account') }}" class="btn btn-outline-dark rounded-pill px-3">Mon compte</a>
                    <a href="{{ path('app_logout') }}" class="btn btn-outline-danger rounded-pill px-3">Déconnexion</a>
                {% else %}
                    <a href="{{ path('app_login') }}" class="btn btn-outline-dark rounded-pill px-3">Connexion</a>
                    <a href="{{ path('app_register') }}" class="btn btn-coral rounded-pill px-3">Inscription</a>
                {% endif %}
            </div>
        </div>
    </div>
</nav>
        {% block body %}{% endblock %}

       <!-- Footer fixe en bas -->
        <footer class="bg-white border-top py-4 mt-auto">
            <div class="container text-center text-muted fs-7">
                <div class="mb-2">
                    <a href="{{ path('app_legal_mentions') }}" class="text-decoration-none text-muted me-3">Mentions légales</a>
                    <a href="{{ path('app_privacy_policy') }}" class="text-decoration-none text-muted me-3">Politique de confidentialité</a>
                    <a href="{{ path('app_cgv') }}" class="text-decoration-none text-muted">CGV</a>
                </div>
                <p class="mb-0">&copy; 2026 Flore Brezilienne. Tous droits réservés.</p>
            </div>
        </footer>

        <!-- JS Scripts -->
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
        <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
        {% block javascripts %}
        <script>
            document.addEventListener("DOMContentLoaded", function() {
            const navbar = document.getElementById('mainNavbar');

            window.addEventListener('scroll', function() {
            if (window.scrollY > 50) {
                navbar.classList.add('navbar-scrolled');
            } else {
                navbar.classList.remove('navbar-scrolled');
            }
                });
            });
        </script>
        {% endblock %}
    </body>
</html>