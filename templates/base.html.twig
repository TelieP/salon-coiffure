<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>{% block title %}bresilienne F - Salon de Coiffure{% endblock %}</title>
        <!-- Bootstrap 5 CSS -->
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
        <!-- FontAwesome -->
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
        <!-- Leaflet CSS (Pour la carte) -->
        <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
        <!-- Google Fonts (Plus Jakarta Sans) -->
        <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
        
        <style>
            :root {
                --salonkee-coral: #f18763;
                --salonkee-coral-hover: #e07450;
                --salonkee-bg: #f9fafb;
                --text-dark: #2d3748;
            }
            body { 
                font-family: 'Plus Jakarta Sans', sans-serif; 
                background-color: var(--salonkee-bg); 
                color: var(--text-dark);
            }
            .btn-coral {
                background-color: var(--salonkee-coral);
                color: white;
                font-weight: 600;
                border: none;
                border-radius: 8px;
            }
            .btn-coral:hover {
                background-color: var(--salonkee-coral-hover);
                color: white;
            }
            .text-coral { color: var(--salonkee-coral); }
            .badge-verified {
                background-color: #e6f4ea;
                color: #137333;
                font-size: 0.8rem;
                font-weight: 600;
            }
            .star-rating { color: #f5a623; }
        </style>
        {% block stylesheets %}{% endblock %}
    </head>
    <body>
        <!-- Barre de Navigation de style Salonkee -->
        <nav class="navbar navbar-expand-lg bg-white border-bottom py-3 sticky-top">
            <div class="container">
                <!-- Nom/Logo du salon à gauche -->
                <a class="navbar-brand fw-bold text-dark" href="{{ path('app_home') }}">
                    <span class="text-coral">Flore</span> Brezilienne
                </a>

                <!-- Boutons d'authentification à droite -->
                <div class="ms-auto d-flex align-items-center gap-2">
                    {% if app.user %}
                        <span class="text-muted small me-2">Bonjour, {{ app.user.email }}</span>
                        <a href="{{ path('app_account') }}" class="btn btn-outline-dark btn-sm rounded-pill px-3">Mon compte</a>
                        <a href="{{ path('app_logout') }}" class="btn btn-outline-danger btn-sm rounded-pill px-3">Déconnexion</a>
                    {% else %}
                        <a href="{{ path('app_login') }}" class="btn btn-outline-primary btn-sm rounded-pill px-3 shadow-sm">Connexion</a>
                        <a href="{{ path('app_register') }}" class="btn btn-primary btn-sm rounded-pill px-3 shadow-sm" style="background-color: #ff7f50; border-color: #ff7f50;">Inscription</a>
                    {% endif %}
                </div>
            </div>
        </nav>

        {% block body %}{% endblock %}

       <!-- Footer fixe en bas -->
        <footer class="bg-white border-top py-4 mt-auto">
            <div class="container text-center text-muted fs-7">
                <div class="mb-2">
                    <a href="{{ path('app_legal_mentions') }}" class="text-decoration-none text-muted me-3">Mentions légales</a>
                    <a href="{{ path('app_privacy_policy') }}" class="text-decoration-none text-muted me-3">Politique de confidentialité</a>
                    <a href="{{ path('app_cgv') }}" class="text-decoration-none text-muted">CGV</a>
                </div>
                <p class="mb-0">&copy; 2026 Flore Brezilienne. Tous droits réservés.</p>
            </div>
        </footer>

        <!-- JS Scripts -->
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
        <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
        {% block javascripts %}{% endblock %}
    </body>
</html>