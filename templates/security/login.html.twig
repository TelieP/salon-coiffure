{% extends 'base.html.twig' %}

{% block title %}Connexion - Flore Brésilienne{% endblock %}

{% block body %}
<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
                <form method="post">
                    {% if error %}
                        <div class="alert alert-danger rounded-3 mb-3" role="alert">
                            {{ error.messageKey|trans(error.messageData, 'security') }}
                        </div>
                    {% endif %}

                    {% if app.user %}
                        <div class="mb-3 text-center">
                            Vous êtes déjà connecté en tant que {{ app.user.userIdentifier }}, <a href="{{ path('app_logout') }}" class="text-coral text-decoration-none fw-semibold">Déconnexion</a>
                        </div>
                    {% endif %}

                    <h1 class="h3 mb-4 fw-bold text-center text-dark">Connexion</h1>

                    <div class="mb-3">
                        <label for="inputEmail" class="form-label fw-semibold">Adresse email</label>
                        <input type="email" value="{{ last_username }}" name="email" id="inputEmail" class="form-control rounded-3 py-2" autocomplete="email" required autofocus>
                    </div>

                    <div class="mb-3">
                        <label for="inputPassword" class="form-label fw-semibold">Mot de passe</label>
                        <input type="password" name="password" id="inputPassword" class="form-control rounded-3 py-2" autocomplete="current-password" required>
                    </div>

                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                    <div class="mb-3 form-check">
                        <input type="checkbox" name="_remember_me" id="_remember_me" class="form-check-input">
                        <label class="form-check-label text-muted small" for="_remember_me">Se souvenir de moi</label>
                    </div>

                    <div class="d-grid gap-2 mt-4">
                        <button class="btn btn-coral py-2 shadow-sm" type="submit">
                            Se connecter
                        </button>
                    </div>
                    
                    <p class="text-center mt-3 small text-muted">Vous n'avez pas de compte ? <a href="{{ path('app_register') }}" class="text-decoration-none">Inscrivez-vous</a></p>   

                </form>
            </div>
        </div>
    </div>
</div>
{% endblock %}