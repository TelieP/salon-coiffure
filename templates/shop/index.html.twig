{% extends 'base.html.twig' %}

{% block title %}Boutique - Flore Brésilienne{% endblock %}

{% block body %}
<div class="container py-5">
    <div class="text-center mb-5">
        <h1 class="fw-bold">Notre Boutique en Ligne</h1>
        <p class="text-muted">Retrouvez l'intégralité de nos produits capillaires et soins professionnels.</p>
    </div>

    <div class="row g-4">
        {% for product in products %}
            <div class="col-md-4">
                <div class="card border-0 shadow-sm rounded-4 h-100">
                    <a href="{{ path('app_product_show', {id: product.id}) }}">
                       <img src="{{ product.image ? asset('images/' ~ product.image) : asset('images/image01.jpeg') }}" 
     class="card-img-top rounded-top-4" 
     alt="{{ product.name }}" 
     style="height: 220px; object-fit: contain;">
                    </a>
                    
                    <div class="card-body text-center d-flex flex-column justify-content-center">
                        <div>
                            <h5 class="fw-bold">
                                <a href="{{ path('app_product_show', {id: product.id}) }}" class="text-dark text-decoration-none">
                                    {{ product.name }}
                                </a>
                            </h5>
                            <p class="text-muted small">{{ product.description|striptags }}</p>
                        </div>
                        <div class="mt-3">
                            <span class="text-primary fw-bold fs-5 d-block mb-3">{{ product.price|number_format(2, ',', ' ') }} €</span>
                            <a href="{{ path('app_product_show', {id: product.id}) }}" class="btn btn-primary rounded-pill w-100">Voir le produit</a>
                        </div>
                    </div>
                </div>
            </div>
        {% else %}
            <div class="col-12 text-center py-5">
                <p class="text-muted">Aucun produit disponible pour le moment. Revenez bientôt !</p>
            </div>
        {% endfor %}
    </div>
</div>
{% endblock %}