{% extends 'base.html.twig' %}

{% block title %}Flore Brezilienne- La Louvière{% endblock %}

{% block body %}
<div class="container my-4">

    <!-- Header / En-tête du salon -->
    <div class="row align-items-center mb-4">
        <div class="col-md-8">
            <h1 class="fw-bold mb-1 display-6">Flore Brezilienne</h1>
            <p class="text-coral fw-medium mb-2">Chacun mérite de prendre soin de soi ✨</p>
            <div class="d-flex align-items-center gap-2 text-muted fs-7">
                <span class="fw-bold text-dark"></span>
                <span class="star-rating">
                    <i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i>
                </span>
                <span>• <i class="fas fa-map-marker-alt text-muted me-1"></i>Rue de la Déportation 14, 7100 La Louvière</span>
            </div>
        </div>
        <div class="col-md-4 text-md-end mt-3 mt-md-0">
           <a href="#prestations" class="btn btn-coral btn-lg px-4 py-2 shadow-sm">
                <i class="far fa-calendar-alt me-2"></i>Prendre rendez-vous
            </a>
        </div>
    </div>

   {# Section Carrousel d'images à la place de l'image fixe #}
<div class="container my-4">
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
        <div id="salonCarousel" class="carousel slide" data-bs-ride="carousel" data-bs-interval="4000">
            <!-- Indicateurs du carrousel (les petits points en bas) -->
            <div class="carousel-indicators">
                <button type="button" data-bs-target="#salonCarousel" data-bs-slide-to="0" class="active" aria-current="true" aria-label="Slide 1"></button>
                <button type="button" data-bs-target="#salonCarousel" data-bs-slide-to="1" aria-label="Slide 2"></button>
                <button type="button" data-bs-target="#salonCarousel" data-bs-slide-to="2" aria-label="Slide 3"></button>
            </div>

            <!-- Les images qui défilent -->
            <div class="carousel-inner">
                <div class="carousel-item active">
                    <img src="{{ asset('images/carousel01.jpg') }}" class="d-block w-100 object-fit-cover" style="height: 450px;" alt="Salon Intérieur">
                </div>
                <div class="carousel-item">
                    <img src="{{ asset('images/carousel02.jpeg') }}" class="d-block w-100 object-fit-cover" style="height: 450px;" alt="Soin Cheveux">
                </div>
                <div class="carousel-item">
                    <img src="{{ asset('images/carousel03.jpg') }}" class="d-block w-100 object-fit-cover" style="height: 450px;" alt="Coiffure et tresses">
                </div>
            </div>

            <!-- Boutons Précédent / Suivant -->
            <button class="carousel-control-prev" type="button" data-bs-target="#salonCarousel" data-bs-slide="prev">
                <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Précédent</span>
            </button>
            <button class="carousel-control-next" type="button" data-bs-target="#salonCarousel" data-bs-slide="next">
                <span class="carousel-control-next-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Suivant</span>
            </button>
        </div>
    </div>
</div>

    <!-- Description du salon -->
    <div class="card border-0 shadow-sm rounded-4 p-4 mb-5 bg-white">
        <p class="mb-0 text-secondary leading-relaxed">
            Bienvenue dans notre salon de coiffure, un espace chaleureux où nous mettons notre savoir-faire au service de vos envies. ✨ Des prestations personnalisées, des conseils adaptés et des tarifs accessibles à tous. Le salon fonctionne principalement sur rendez-vous, avec une certaine flexibilité selon les prestations et vos disponibilités. 💇‍♀️💖
        </p>
    </div>

    <!-- Section Prestations -->
    <div id="prestations" class="mb-5">
        <h3 class="fw-bold mb-4">Nos Prestations</h3>
        <div class="row g-3">
            {% for service in services %}
                <div class="col-md-6 col-lg-4">
                    <div class="card border-0 shadow-sm rounded-4 h-100 p-3 bg-white">
                        <div class="card-body d-flex flex-column justify-content-between">
                            <div>
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <h5 class="fw-bold text-dark mb-0">{{ service.name }}</h5>
                                    <span class="fw-bold text-coral fs-5">{{ service.price }} €</span>
                                </div>
                                <p class="text-muted small mb-3">{{ service.description }}</p>
                            </div>
                            <div>
                                <div class="text-muted small mb-3">
                                    <i class="far fa-clock me-1"></i> {{ service.duration }} min
                                </div>
                                <a href="{{ path('app_booking', {'id': service.id}) }}" class="btn btn-coral w-100 py-2">Choisir & Réserver</a>
                            </div>
                        </div>
                    </div>
                </div>
            {% else %}
                <div class="col-12">
                    <div class="alert alert-light border rounded-4 text-center p-4">
                        <i class="fas fa-info-circle text-coral fa-2x mb-2"></i>
                        <p class="mb-0">Aucune prestation n'est configurée pour le moment. Ajoutez-en depuis votre administration.</p>
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>

        {# Section Produits #}
<section id="produits" class="py-5 bg-light">
    <div class="container">
        <div class="text-center mb-5">
            <h2 class="fw-bold">Nos Produits & Soins</h2>
            <p class="text-muted">Découvrez notre sélection de produits professionnels pour entretenir vos cheveux au quotidien.</p>
        </div>

        <div class="row g-4">
            {% for product in products|slice(0, 3) %}
                <div class="col-md-4">
                    <div class="card border-0 shadow-sm rounded-4 h-100 product-card">
                        <!-- Image cliquable redirigeant vers la fiche produit -->
                        <a href="{{ path('app_product_show', {id: product.id}) }}">
                           <img src="{{ product.image ? asset('images/' ~ product.image) : asset('images/image01.jpeg') }}" 
     class="card-img-top rounded-top-4" 
     alt="{{ product.name }}" 
     style="height: 220px; object-fit: contain;">
                        </a>
                        
                        <div class="card-body text-center d-flex flex-column justify-content-center">
                            <div>
                                <h5 class="fw-bold">
                                    <a href="{{ path('app_product_show', {id: product.id}) }}" class="text-dark text-decoration-none">
                                        {{ product.name }}
                                    </a>
                                </h5>
                                <p class="text-muted small">{{ product.description|striptags }}</p>
                            </div>
                            <div class="mt-3">
                                <span class="text-primary fw-bold fs-5 d-block mb-2">{{ product.price|number_format(2, ',', ' ') }} €</span>
                                <a href="{{ path('app_product_show', {id: product.id}) }}" class="btn btn-outline-dark rounded-pill btn-sm px-4">Voir le produit</a>
                            </div>
                        </div>
                    </div>
                </div>
            {% else %}
                <div class="col-12 text-center">
                    <p class="text-muted">Aucun produit pour le moment.</p>
                </div>
            {% endfor %}
        </div>

        <!-- Bouton "Voir plus de produits" redirigeant vers la boutique -->
        <div class="text-center mt-5">
            <a href="{{ path('app_shop') }}" class="btn btn-dark rounded-pill px-5 py-3 fw-semibold shadow-sm">
                Voir plus de produits &rarr;
            </a>
        </div>
    </div>
</section>

    <!-- Section Informations (Carte & Horaires) -->
    <div class="mb-5">
        <h3 class="fw-bold mb-4">Informations</h3>
        <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
            <!-- Carte Leaflet / Map -->
            <div id="map" class="rounded-3 mb-4" style="height: 300px; width: 100%;"></div>

            <div class="row g-4">
                <div class="col-md-6">
                    <h6 class="fw-bold mb-3">Heures d'ouverture</h6>
                    <ul class="list-unstyled text-secondary small">
                        <li class="d-flex justify-content-between py-1 border-bottom"><span>Lundi - Vendredi</span> <span>09:30 - 17:00</span></li>
                        <li class="d-flex justify-content-between py-1 border-bottom"><span>Samedi</span> <span class="text-danger fw-semibold">Fermé</span></li>
                        <li class="d-flex justify-content-between py-1 border-bottom"><span>Dimanche</span> <span>10:00 - 13:00</span></li>
                    </ul>
                </div>
                <div class="col-md-6">
                    <h6 class="fw-bold mb-3">Contact & Localisation</h6>
                    <ul class="list-unstyled text-secondary small">
                        <li class="mb-2"><i class="fas fa-map-marker-alt text-coral me-2"></i>Rue de la Déportation 14, 7100 La Louvière</li>
                        <li class="mb-2"><i class="fas fa-file-invoice text-coral me-2"></i>BE1026520019</li>
                        <li class="mb-2"><i class="fas fa-phone text-coral me-2"></i>+32 496 43 81 34</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>

   <!-- Section Avis Clients -->
<div class="container my-5 py-5 border-top">
    <div class="row mb-4 align-items-center">
        <h2 class="fw-bold">Commentaires ({{ countReviews }})</h2>
<p class="text-muted">Ce salon a des avis vérifiés. Découvrez l'expérience de nos clients.</p>

{# Remplacement du lien direct par la condition de connexion #}
{% if app.user %}
    <a href="{{ path('app_review_new') }}" class="btn btn-outline-primary rounded-pill px-4">Écrire un commentaire</a>
{% else %}
    <a href="{{ path('app_login') }}" class="btn btn-outline-secondary rounded-pill px-4">
        <i class="bi bi-lock-fill me-1"></i>  Ecrire un avis
    </a>
{% endif %}
        <div class="col-md-4 text-md-end mt-3 mt-md-0">
            <div class="p-3 bg-light rounded-4 shadow-sm d-inline-block text-start">
                <span class="fs-5 fw-bold text-dark">Note Moyenne {{ averageRating }} / 5</span>
                <div class="text-warning">
                    {% for i in 1..5 %}
                        <i class="bi bi-star-fill"></i>
                    {% endfor %}
                </div>
            </div>
        </div>
    </div>

    <!-- Liste des avis -->
    <div class="row g-4">
        {% for review in reviews %}
            <div class="col-12">
                <div class="card shadow-sm border-0 rounded-4 p-4">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <div class="d-flex align-items-center">
                            <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center fw-bold me-3" style="width: 45px; height: 45px;">
                                {{ review.clientName|slice(0,1)|upper }}
                            </div>
                            <div>
                                <h5 class="mb-0 fw-bold">{{ review.clientName }}</h5>
                                <small class="text-muted">{{ review.createdAt|date('d.m.Y') }}</small>
                            </div>
                        </div>
                        <div>
                            {% if review.isVerified %}
                                <span class="badge bg-success bg-opacity-10 text-success px-3 py-2 rounded-pill fw-semibold">
                                    <i class="bi bi-check-circle-fill me-1"></i> Vérifié
                                </span>
                            {% endif %}
                            <div class="text-warning mt-1 text-end">
                                {% for i in 1..review.rating %}
                                    <i class="bi bi-star-fill"></i>
                                {% endfor %}
                            </div>
                        </div>
                    </div>

                    {% if review.comment %}
                        <p class="text-dark mt-2 mb-3">{{ review.comment }}</p>
                    {% endif %}

                    {% if review.reply %}
                        <div class="bg-light p-3 rounded-3 mt-3 border-start border-primary border-4">
                            <h6 class="fw-bold text-primary mb-1">Lauréliebybeauty a répondu :</h6>
                            <p class="mb-0 text-muted small">{{ review.reply }}</p>
                        </div>
                    {% endif %}
                </div>
            </div>
        {% else %}
            <div class="col-12 text-center py-4">
                <p class="text-muted">Aucun commentaire pour le moment. Soyez le premier à laisser votre avis !</p>
            </div>
        {% endfor %}
    </div>
</div>

</div>
<!-- Section Galerie / Réalisations -->
    <div class="container my-5">
        <div class="text-center mb-4">
            <h3 class="fw-bold">Aperçu de nos réalisations</h3>
            <p class="text-muted">Découvrez quelques-unes de nos coiffures et prestations</p>
        </div>
        
        <div class="row g-4">
            <div class="col-6 col-md-4 col-lg-2">
                <div class="card border-0 shadow-sm rounded-4 overflow-hidden h-100 bg-white">
                    <img src="{{ asset('images/image01.jpeg') }}" class="w-100 object-fit-cover" style="height: 220px;" alt="Coiffure 1">
                </div>
            </div>
            <div class="col-6 col-md-4 col-lg-2">
                <div class="card border-0 shadow-sm rounded-4 overflow-hidden h-100 bg-white">
                    <img src="{{ asset('images/image02.jpeg') }}" class="w-100 object-fit-cover" style="height: 220px;" alt="Coiffure 2">
                </div>
            </div>
            <div class="col-6 col-md-4 col-lg-2">
                <div class="card border-0 shadow-sm rounded-4 overflow-hidden h-100 bg-white">
                    <img src="{{ asset('images/image03.jpeg') }}" class="w-100 object-fit-cover" style="height: 220px;" alt="Coiffure 3">
                </div>
            </div>
            <div class="col-6 col-md-4 col-lg-2">
                <div class="card border-0 shadow-sm rounded-4 overflow-hidden h-100 bg-white">
                    <img src="{{ asset('images/image04.jpg') }}" class="w-100 object-fit-cover" style="height: 220px;" alt="Coiffure 4">
                </div>
            </div>
            <div class="col-6 col-md-4 col-lg-2">
                <div class="card border-0 shadow-sm rounded-4 overflow-hidden h-100 bg-white">
                    <img src="{{ asset('images/image05.jpg') }}" class="w-100 object-fit-cover" style="height: 220px;" alt="Coiffure 5">
                </div>
            </div>
            <div class="col-6 col-md-4 col-lg-2">
                <div class="card border-0 shadow-sm rounded-4 overflow-hidden h-100 bg-white">
                    <img src="{{ asset('images/image06.jpg') }}" class="w-100 object-fit-cover" style="height: 220px;" alt="Coiffure 6">
                </div>
            </div>
            
        </div>
    </div>

{% endblock %}

{% block javascripts %}
<script>
    document.addEventListener("DOMContentLoaded", function() {
        // Coordonnées pour Rue de la Déportation 14, 7100 La Louvière
        var lat = 50.4781;
        var lng = 4.1862;
        
        var map = L.map('map').setView([lat, lng], 15);
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            attribution: '&copy; OpenStreetMap contributors'
        }).addTo(map);

        L.marker([lat, lng]).addTo(map)
            .bindPopup('<b>Lauréliebybeauty</b><br>Rue de la Déportation 14')
            .openPopup();
    });
</script>
{% endblock %}