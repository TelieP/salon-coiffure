{% extends 'base.html.twig' %}

{% block title %}Rendez-vous confirmé !{% endblock %}

{% block body %}
<div class="container my-5 text-center">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card border-0 shadow-sm rounded-4 p-5 bg-white">
                <div class="text-success mb-3">
                    <i class="fas fa-check-circle fa-4x"></i>
                </div>
                <h2 class="fw-bold mb-2">Rendez-vous confirmé !</h2>
                <p class="text-muted">Merci pour votre confiance. Votre séance pour <strong>{{ appointment.service.name }}</strong> a été enregistrée.</p>
                
                <div class="bg-light rounded-3 p-3 my-4 text-start small">
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Prestation :</span>
                        <span class="fw-bold">{{ appointment.service.name }}</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Date & Heure :</span>
                        <span class="fw-bold">{{ appointment.startAt|date('d/m/Y à H:i') }}</span>
                    </div>
                    <div class="d-flex justify-content-between">
                        <span class="text-muted">Tarif :</span>
                        <span class="fw-bold text-coral">{{ appointment.service.price }} €</span>
                    </div>
                </div>

                <a href="{{ path('app_home') }}" class="btn btn-coral px-4 py-2">Retour à l'accueil</a>
            </div>
        </div>
    </div>
</div>
{% endblock %}