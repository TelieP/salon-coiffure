{% extends 'base.html.twig' %}

{% block title %}Mon espace personnel - Flore Brésilienne{% endblock %}

{% block body %}
<div class="container my-5">
    <!-- En-tête de bienvenue -->
    <div class="card border-0 shadow-sm rounded-4 p-4 bg-white mb-4">
        <h1 class="h3 fw-bold text-dark mb-1">Mon Espace Personnel</h1>
        <p class="text-muted mb-0">Bienvenue, {{ app.user.lastname }}. Retrouvez ci-dessous l'historique de vos rendez-vous et de vos commandes.</p>
    </div>

    <!-- Section : Mes Rendez-vous -->
    <div class="card border-0 shadow-sm rounded-4 p-4 bg-white mb-4">
        <h4 class="fw-bold text-dark mb-3">Mes Rendez-vous</h4>

        {% if appointments is empty %}
            <div class="alert alert-light text-center py-4 border rounded-3 text-muted mb-0">
                Vous n'avez pas encore de rendez-vous enregistré.
            </div>
        {% else %}
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead>
                        <tr>
                            <th>Prestation</th>
                            <th>Date & Heure</th>
                            <th>Prix Total</th>
                            <th>Acompte (20%)</th>
                            <th>Statut</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for appointment in appointments %}
                            <tr>
                                <td class="fw-semibold">{{ appointment.service.name }}</td>
                                <td>{{ appointment.startAt ? appointment.startAt|date('d/m/Y  à H:i') : 'N/A' }}</td>
                                <td>{{ appointment.totalPrice }} €</td>
                                <td>{{ appointment.depositAmount }} €</td>
                                <td>
                                    {% if appointment.status == 'confirmed' %}
                                        <span class="badge bg-success rounded-pill px-3 py-2">Confirmé</span>
                                    {% else %}
                                        <span class="badge bg-warning text-dark rounded-pill px-3 py-2">En attente</span>
                                    {% endif %}
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    </div>

    <!-- Section : Mes Commandes Boutique -->
    <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
        <h4 class="fw-bold text-dark mb-3">Mes Commandes Boutique</h4>

        {% if orders is empty %}
            <div class="alert alert-light text-center py-4 border rounded-3 text-muted mb-0">
                Vous n'avez pas encore passé de commande dans la boutique.
            </div>
        {% else %}
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead>
                        <tr>
                            <th>Référence</th>
                            <th>Date</th>
                            <th>Statut</th>
                            <th>Total</th>
                            <th class="text-end">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for order in orders %}
                            <tr>
                                <td class="fw-bold">#{{ order.id }}</td>
                                <td>{{ order.createdAt ? order.createdAt|date('d/m/Y à H:i') : 'N/A' }}</td>
                                <td>
                                    {% if order.status == 'paid' %}
                                        <span class="badge bg-success bg-opacity-10 text-success px-3 py-2 rounded-pill">Payée</span>
                                    {% elseif order.status == 'pending' %}
                                        <span class="badge bg-warning bg-opacity-10 text-dark px-3 py-2 rounded-pill">En attente</span>
                                    {% else %}
                                        <span class="badge bg-secondary px-3 py-2 rounded-pill">{{ order.status }}</span>
                                    {% endif %}
                                </td>
                                <td class="fw-bold text-primary">{{ order.total|number_format(2, ',', ' ') }} €</td>
                                <td class="text-end">
                                    <a href="{{ path('app_account_order_show', {id: order.id}) }}" class="btn btn-sm btn-outline-dark rounded-pill px-3">
                                        Voir le détail
                                    </a>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    </div>
</div>
{% endblock %}