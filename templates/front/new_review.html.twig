{% extends 'base.html.twig' %}

{% block title %}Laisser un avis - Lauréliebybeauty{% endblock %}

{% block body %}
<div class="container my-5" style="max-width: 600px;">
    <div class="card shadow-sm border-0 rounded-4 p-4">
        <h2 class="fw-bold mb-3 text-center">Partagez votre expérience</h2>
        <p class="text-muted text-center mb-4">Votre avis nous aide à nous améliorer et guide nos futurs clients.</p>

        {{ form_start(form) }}
            <div class="mb-3">
                {{ form_row(form.clientName) }}
            </div>
            <div class="mb-3">
                {{ form_row(form.rating) }}
            </div>
            <div class="mb-3">
                {{ form_row(form.comment) }}
            </div>
            <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold rounded-pill shadow-sm">Publier mon avis</button>
        {{ form_end(form) }}

        <div class="text-center mt-3">
            <a href="{{ path('app_home') }}" class="text-decoration-none text-muted">← Retour à l'accueil</a>
        </div>
    </div>
</div>
{% endblock %}